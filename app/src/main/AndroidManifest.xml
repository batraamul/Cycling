<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest is the app's "identity card" for Android: which permissions it needs,
  which screens (activities), background services and broadcast receivers exist.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Step counting (runtime permission on Android 10+). Also qualifies the 'health' FGS type. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- GPS for cycling rides only (runtime permission). No background-location permission is requested. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Foreground service = the persistent notification that keeps tracking alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Show the tracking notification (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restart walking tracking after the phone reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only used if the phone lacks a hardware step counter AND a wake-up accelerometer. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the app open the system "ignore battery optimisation" dialog (OxygenOS kills background apps aggressively). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".CyclingApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cycling"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ONE service owns all tracking, so walking and cycling can never run as two independent trackers. -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <receiver
            android:name=".tracking.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
